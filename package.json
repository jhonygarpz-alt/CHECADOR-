{
  "name": "asisteapp",
  "version": "1.0.0",
  "description": "Control de asistencia con reconocimiento facial, geolocalización, zonas horarias y reportes en tiempo real, sobre Supabase.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "supabase:start": "supabase start -x studio,imgproxy,logflare,vector,mailpit,postgres-meta,supavisor",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "postgres": "^3.4.9",
    "supabase": "^2.120.0"
  }
}
